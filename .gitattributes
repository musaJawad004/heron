# Check every text file out with LF, on every platform. Without this, Windows
# runners get CRLF and prettier --check fails on the whole tree.
* text=auto eol=lf

# Binary, never touched.
*.png binary
*.gif binary
*.icns binary
*.ico binary
*.woff binary
*.woff2 binary
*.dmg binary
*.mov binary

# Generated: keep them out of diffs and language stats.
yarn.lock linguist-generated=true
src-tauri/Cargo.lock linguist-generated=true
docs/media/* linguist-documentation=true
